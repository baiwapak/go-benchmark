# Server
SERVER_ADDR=:8000
SERVER_MODE=debug

# Language: zh | en
DEFAULT_LANG=zh

# Report storage (relative to working directory or absolute)
REPORT_DIR=data/reports

# Hard limits
MAX_CONCURRENCY=200
MAX_DURATION_SEC=300
MAX_TIMEOUT_SEC=60
MAX_INFLIGHT_JOBS=3

# Create-job rate limit (requests per minute per IP)
CREATE_RATE_LIMIT_PER_MIN=10

# CORS (comma-separated; empty = same-origin only in release)
CORS_ALLOW_ORIGINS=
