# Server
SERVER_ADDR=:8000
SERVER_MODE=debug

# Language: zh | en
DEFAULT_LANG=zh

# Report storage (relative to working directory or absolute)
REPORT_DIR=data/reports

# Hard limits (omit to auto-detect from this machine's CPU and memory)
# MAX_CONCURRENCY=200
# MAX_DURATION_SEC=300
# MAX_INFLIGHT_JOBS=3
MAX_TIMEOUT_SEC=60

# Create-job rate limit (requests per minute per IP)
CREATE_RATE_LIMIT_PER_MIN=10

# Ramp-up max seconds; max request body bytes
MAX_RAMP_SEC=120
MAX_BODY_BYTES=65536

# GitHub repository URL (homepage fork icon)
GITHUB_REPO_URL=https://github.com/yourorg/go-benchmark

# CORS (comma-separated; empty = same-origin only in release)
CORS_ALLOW_ORIGINS=
